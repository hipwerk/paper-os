# Hostname or SSH alias for a Raspberry Pi running 64-bit Raspberry Pi OS.
PAPEROS_PI_HOST=paperos.local
PAPEROS_PI_USER=paperos

# Required only for real hardware. Copy the magnitude printed on this panel's
# FPC, in millivolts. Example: -1.50 V becomes 1500. Never guess this value.
PAPEROS_VCOM_MV=

PAPEROS_SPI_DEVICE=/dev/spidev0.0
PAPEROS_GPIO_CHIP=/dev/gpiochip0
PAPEROS_RESET_LINE=17
PAPEROS_READY_LINE=24
